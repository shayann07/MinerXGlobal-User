<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- transparent base with rounded bounds so the glow follows the card -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>

    <!-- outer halo: TRANSPARENT center → soft orange band → TRANSPARENT edges -->
    <!-- big radius so it looks like a glow, not a border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:centerColor="#33EF7D43"
                android:centerX="0.5"
                android:centerY="0.5"
                android:endColor="#00EE6924"
                android:gradientRadius="520dp"
                android:startColor="#00EE6924"
                android:type="radial" />
        </shape>
    </item>
</layer-list>