<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base darker graphite gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="180"
                android:startColor="#050505"
                android:centerColor="#0C0C0C"
                android:endColor="#141414"/>
        </shape>
    </item>

    <!-- Darker diagonal brushed lines -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#33000000"
                android:centerColor="#11000000"
                android:endColor="#33000000"
                android:tileMode="repeat"/>
            <!-- tighter spacing for heavier look -->
            <size android:width="6dp" android:height="6dp"/>
        </shape>
    </item>

    <!-- More subtle metallic highlight across middle -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#00000000"
                android:centerColor="#0DFFFFFF"
                android:endColor="#00000000"/>
        </shape>
    </item>

    <!-- Stronger vignette for depth -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#66000000"
                android:centerColor="#00000000"
                android:endColor="#66000000"/>
        </shape>
    </item>

</layer-list>