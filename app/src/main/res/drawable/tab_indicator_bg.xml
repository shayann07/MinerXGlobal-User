<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1. Base sweep: deep blue-violet -->
    <item>
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="20dp"
                android:topRightRadius="20dp" />
            <gradient
                android:angle="135"
                android:centerColor="#FF4551A3"
                android:endColor="#FF3A4996"
                android:startColor="#FF4B5EA9"
                android:type="linear" />
        </shape>
    </item>

    <!-- 2. Central radial glow for “lit-from-within” feel -->
    <item>
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="20dp"
                android:topRightRadius="20dp" />
            <gradient
                android:centerX="50%"
                android:centerY="50%"
                android:endColor="#00FFFFFF"
                android:gradientRadius="180dp"
                android:startColor="#66FFFFFF"
                android:type="radial" />
        </shape>
    </item>

    <!-- 3. Soft diagonal light beam (bottom-left ➜ top-right) -->
    <item>
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="20dp"
                android:topRightRadius="20dp" />
            <gradient
                android:angle="315"
                android:centerColor="#22FFFFFF"
                android:endColor="#00FFFFFF"
                android:startColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>

    <!-- 4. Frosted-glass overlay -->
    <item>
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="20dp"
                android:topRightRadius="20dp" />
            <gradient
                android:angle="90"
                android:centerColor="#0DFFFFFF"
                android:endColor="#04FFFFFF"
                android:startColor="#1AFFFFFF"
                android:type="linear" />
        </shape>
    </item>

    <!-- 5. Subtle bottom shadow for depth -->
    <item>
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="20dp"
                android:topRightRadius="20dp" />
            <gradient
                android:angle="270"
                android:endColor="#00000000"
                android:startColor="#33000000"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
