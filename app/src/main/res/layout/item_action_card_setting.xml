<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:id="@+id/itemSetting"
    android:gravity="center"
    android:orientation="vertical"
    >

    <!-- Outer container with rounded corners and gradient -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="10dp"
        app:strokeColor="@android:color/transparent"
        app:strokeWidth="0dp">

        <!-- Gradient background with rounded corners -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glassy_bg_gradient">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginVertical="14dp"
                android:gravity="center"
                android:orientation="vertical">

                <!-- Inner icon holder -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:strokeWidth="0dp"
                    app:cardCornerRadius="8dp">

                    <ImageView
                        android:id="@+id/actionIcon"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_gravity="center"
                        android:src="@drawable/money_tag_ic"
                        />
                </com.google.android.material.card.MaterialCardView>


            </LinearLayout>

        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>
    <!-- Label -->
    <TextView
        android:id="@+id/actionLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/item_action_card_setting_swap"
        android:textAlignment="center"
        android:textColor="@android:color/white"
        android:textSize="10sp" />
</LinearLayout>
