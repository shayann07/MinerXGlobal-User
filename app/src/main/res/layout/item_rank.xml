<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Subtle selectable ripple -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/levelCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="0dp"
        android:foreground="?attr/selectableItemBackground"
        android:outlineAmbientShadowColor="#A9FF7B00"
        android:outlineSpotShadowColor="#A9FF7B00"
        app:cardBackgroundColor="@color/main_card_color"
        app:cardCornerRadius="20dp"
        app:cardElevation="12dp"
        app:cardUseCompatPadding="true"
        app:strokeColor="@android:color/transparent"
        app:strokeWidth="0dp">

        <!-- Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="18dp">

            <!-- Left icon with halo -->
            <FrameLayout
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="14dp"
                android:padding="1dp">

                <!-- Radial glow behind icon (baseline) -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0.07"
                    android:background="@drawable/glow_orange" />

                <ImageView
                    android:id="@+id/levelIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/fragment_rank_rewards"
                    android:scaleType="centerInside"
                    android:src="@drawable/splash_bg" />
            </FrameLayout>

            <!-- Right content -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Title + chip -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/rankTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/item_rank_silver"
                        android:textColor="@color/orange"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/statusChip"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/item_rank_locked"
                        android:textColor="@android:color/black"
                        app:checkedIconVisible="false"
                        app:chipCornerRadius="16dp"
                        app:chipEndPadding="10dp"
                        app:chipIconVisible="false"
                        app:chipMinHeight="28dp"
                        app:chipStartPadding="10dp"
                        app:rippleColor="@android:color/transparent" />
                </LinearLayout>

                <TextView
                    android:id="@+id/teamBusiness"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/item_rank_team_business_req_3_000"
                    android:textColor="@color/grey"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/directBusiness"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/item_rank_direct_business_req_500"
                    android:textColor="@color/grey"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/rewardAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/item_rank_reward_100"
                    android:textColor="@color/orange"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</RelativeLayout>