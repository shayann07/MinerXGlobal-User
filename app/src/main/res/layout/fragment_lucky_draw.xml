<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_mxg_deposit_gradient">

    <!-- ① Scroll container -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <!-- Baseline ConstraintLayout -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Guidelines -->
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/gStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_begin="8dp" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/gEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_end="8dp" />

            <!-- Top bar (unchanged) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/topbar"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginTop="@dimen/space_24"
                android:paddingStart="8dp"
                android:paddingEnd="12dp"
                app:layout_constraintEnd_toEndOf="@id/gEnd"
                app:layout_constraintStart_toStartOf="@id/gStart"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/avatar"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/ic_profile"
                    android:contentDescription="@string/app_name"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:id="@+id/titleWrap"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="@id/avatar"
                    app:layout_constraintEnd_toStartOf="@id/actionsRight"
                    app:layout_constraintStart_toEndOf="@id/avatar"
                    app:layout_constraintTop_toTopOf="@id/avatar">

                    <TextView
                        android:id="@+id/hiName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.9"
                        android:text="@string/hi_name"
                        android:textColor="@color/orange"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/welcome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Weekly Lucky Draw"
                        android:textColor="@color/mxg_white_80"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/actionsRight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/menu"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/ic_window"
                        android:contentDescription="@string/open_menu"
                        android:padding="8dp" />

                    <ImageView
                        android:id="@+id/notification_ic"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/ic_bell"
                        android:contentDescription="@string/notifications"
                        android:padding="8dp" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Header card (animated liquid gold) -->
            <FrameLayout
                android:id="@+id/headerWrap"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="@id/gEnd"
                app:layout_constraintStart_toStartOf="@id/gStart"
                app:layout_constraintTop_toBottomOf="@id/topbar">

                <com.minerxgloble.minerxgloble.ui.animation.LiquidGradientCard
                    android:id="@+id/headerCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="0dp"
                    android:outlineAmbientShadowColor="#FF7B00"
                    android:outlineSpotShadowColor="#FF7B00"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="12dp"
                    app:cardUseCompatPadding="true"
                    app:strokeColor="@android:color/transparent"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="36dp">

                        <!-- Card title -->
                        <TextView
                            android:id="@+id/tvLevel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:text="Lucky Draw"
                            android:textColor="@color/black"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <!-- Secondary line: user's total invested in draw -->
                        <TextView
                            android:id="@+id/tvMyTotalInvested"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="36dp"
                            android:background="@drawable/bg_referral_home"
                            android:drawablePadding="8dp"
                            android:ellipsize="end"

                            android:paddingHorizontal="12dp"
                            android:paddingVertical="10dp"
                            android:singleLine="true"
                            android:textAlignment="center"
                            android:text="Your total invested in draw: $0"
                            android:textColor="@color/black"
                            android:textSize="12sp"
                            app:drawableTint="#A2EE6924" />
                    </LinearLayout>
                </com.minerxgloble.minerxgloble.ui.animation.LiquidGradientCard>
            </FrameLayout>


            <!-- Invest button (PLACED RIGHT BELOW THE CARD) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnInvest"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp"
                android:text="@string/invest_1"
                android:textAllCaps="false"
                android:textColor="@color/mxg_white"
                app:backgroundTint="@color/orange"
                app:cornerRadius="18dp"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                android:layout_margin="20dp"
                app:layout_constraintTop_toBottomOf="@id/headerWrap"
                app:layout_constraintStart_toStartOf="@id/gStart"
                app:layout_constraintEnd_toEndOf="@id/gEnd" />

            <!-- Section header (now says Winners) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/sectionHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:paddingStart="8dp"
                android:paddingEnd="12dp"
                app:layout_constraintEnd_toEndOf="@id/gEnd"
                app:layout_constraintStart_toStartOf="@id/gStart"
                app:layout_constraintTop_toBottomOf="@id/btnInvest">

                <TextView
                    android:id="@+id/tvLevels"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:text="Winners"
                    android:textColor="@color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@id/filterAllBtn"
                    app:layout_constraintEnd_toStartOf="@id/filterAllBtn"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />


            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Info banner -->
            <TextView
                android:id="@+id/infoBanner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:paddingStart="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:text="@string/winners_are_announced_every_sunday"
                android:textColor="@color/grey"
                android:textSize="13sp"
                app:layout_constraintEnd_toEndOf="@id/gEnd"
                app:layout_constraintStart_toStartOf="@id/gStart"
                app:layout_constraintTop_toBottomOf="@id/sectionHeader" />

            <!-- LIST AREA -> Winners list + shimmer -->
            <FrameLayout
                android:id="@+id/winnersListContainer"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@id/gEnd"
                app:layout_constraintStart_toStartOf="@id/gStart"
                app:layout_constraintTop_toBottomOf="@id/infoBanner">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvWinners"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_winner" />

                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmerWinners"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="16dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="16dp"
                    android:visibility="gone"
                    app:shimmer_auto_start="false"
                    app:shimmer_base_alpha="0.9"
                    app:shimmer_duration="1100"
                    app:shimmer_highlight_alpha="0.6"
                    app:shimmer_intensity="0.35">

                    <LinearLayout
                        android:id="@+id/skeletonWinnerList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:divider="@drawable/divider_rank_list_gap"
                        android:orientation="vertical"
                        android:showDividers="middle" />
                </com.facebook.shimmer.ShimmerFrameLayout>
            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
