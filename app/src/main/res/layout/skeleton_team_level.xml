<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/levelCardSkeleton"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="#262329"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:strokeColor="@android:color/transparent"
    app:strokeWidth="0dp">

    <!-- Match item_team_level.xml container spacing exactly -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="10dp"
        android:layout_marginVertical="6dp"
        android:padding="12dp">

        <!-- Left icon placeholder: 70dp x 70dp -->
        <View
            android:id="@+id/iconSkeleton"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_skeleton_rounded" />

        <!-- Right column placeholders with SAME left padding as item -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="30dp"
            android:gravity="center_vertical">

            <!-- Title bar -->
            <View
                android:layout_width="140dp"
                android:layout_height="16dp"
                android:background="@drawable/bg_skeleton_rounded" />

            <!-- Total Members -->
            <View
                android:layout_width="180dp"
                android:layout_height="12dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_skeleton_rounded" />

            <!-- Active Members -->
            <View
                android:layout_width="160dp"
                android:layout_height="12dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_skeleton_rounded" />

            <!-- Invested Amount -->
            <View
                android:layout_width="140dp"
                android:layout_height="12dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_skeleton_rounded" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
