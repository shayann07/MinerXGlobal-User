<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_mxg_deposit_gradient">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/gStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_begin="8dp" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/gEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_end="8dp" />

            <!-- TOPBAR -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/topbar"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:paddingStart="8dp"
                android:paddingEnd="12dp"
                app:layout_constraintEnd_toEndOf="@id/gEnd"
                app:layout_constraintStart_toStartOf="@id/gStart"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/avatar"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/ic_profile"
                    android:contentDescription="@string/cd_profile_avatar"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:id="@+id/titleWrap"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="@id/avatar"
                    app:layout_constraintEnd_toStartOf="@id/actionsRight"
                    app:layout_constraintStart_toEndOf="@id/avatar"
                    app:layout_constraintTop_toTopOf="@id/avatar">

                    <TextView
                        android:id="@+id/hiName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hi_name"
                        android:textColor="@color/orange"
                        android:textSize="12sp"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/welcome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fragment_home_welcome_to_minor_x_globe"
                        android:textColor="@color/mxg_white_80"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:ellipsize="end" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/actionsRight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/menu"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/ic_window"
                        android:contentDescription="@string/open_menu"
                        android:padding="8dp" />

                    <ImageView
                        android:id="@+id/notification_ic"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/ic_bell"
                        android:contentDescription="@string/notifications"
                        android:padding="8dp" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- HERO WALLET include (card sits below top bar) -->
            <include
                android:id="@+id/walletHero"
                layout="@layout/item_wallet_hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:layout_constraintEnd_toEndOf="@id/gEnd"
                app:layout_constraintStart_toStartOf="@id/gStart"
                app:layout_constraintTop_toBottomOf="@id/topbar" />

            <!-- QUICK ACTIONS -->



            <!-- STATS GRID -->
            <TextView
                android:id="@+id/statsTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:paddingStart="8dp"
                android:paddingEnd="12dp"
                android:text="@string/overview"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                app:layout_constraintEnd_toEndOf="@id/gEnd"
                app:layout_constraintStart_toStartOf="@id/gStart"
                app:layout_constraintTop_toBottomOf="@id/walletHero" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvStatsGrid"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingTop="8dp"
                app:layout_constraintEnd_toEndOf="@id/gEnd"
                app:layout_constraintStart_toStartOf="@id/gStart"
                app:layout_constraintTop_toBottomOf="@id/statsTitle"

                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="2"
                app:orientation="vertical"
                tools:itemCount="4"

                tools:listitem="@layout/item_stat_small" />

            <!-- STATS GRID shimmer: replace the whole shimmerStatsGrid block -->
            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerStatsGrid"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="@id/gStart"
                app:layout_constraintEnd_toEndOf="@id/gEnd"
                app:layout_constraintTop_toBottomOf="@id/statsTitle"
                app:shimmer_auto_start="false"
                app:shimmer_base_alpha="0.9"
                app:shimmer_duration="1100"
                app:shimmer_highlight_alpha="0.6"
                app:shimmer_intensity="0.35">

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:paddingTop="8dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="6dp"
                        app:layout_columnWeight="1"
                        app:cardCornerRadius="20dp"
                        app:cardUseCompatPadding="true"
                        app:cardElevation="10dp">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="92dp"
                            android:background="@drawable/bg_card_matte" />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="6dp"
                        app:layout_columnWeight="1"
                        app:cardCornerRadius="20dp"
                        app:cardUseCompatPadding="true"
                        app:cardElevation="10dp">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="92dp"
                            android:background="@drawable/bg_card_matte" />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="6dp"
                        app:layout_columnWeight="1"
                        app:cardCornerRadius="20dp"
                        app:cardUseCompatPadding="true"
                        app:cardElevation="10dp">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="92dp"
                            android:background="@drawable/bg_card_matte" />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="6dp"
                        app:layout_columnWeight="1"
                        app:cardCornerRadius="20dp"
                        app:cardUseCompatPadding="true"
                        app:cardElevation="10dp">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="92dp"
                            android:background="@drawable/bg_card_matte" />
                    </com.google.android.material.card.MaterialCardView>
                </GridLayout>
            </com.facebook.shimmer.ShimmerFrameLayout>


            <!-- NETWORK MINI -->
            <TextView
                android:id="@+id/networkTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:paddingStart="8dp"
                android:paddingEnd="12dp"
                android:text="@string/fragment_home_network_stats"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                app:layout_constraintEnd_toEndOf="@id/gEnd"
                app:layout_constraintStart_toStartOf="@id/gStart"
                app:layout_constraintTop_toBottomOf="@id/rvStatsGrid" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvNetworkMini"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingTop="8dp"
                app:layout_constraintEnd_toEndOf="@id/gEnd"
                app:layout_constraintStart_toStartOf="@id/gStart"
                app:layout_constraintTop_toBottomOf="@id/networkTitle"
                app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                app:spanCount="2"
                app:orientation="vertical"
                tools:itemCount="4"
                tools:listitem="@layout/item_network_small" />

            <!-- NETWORK MINI shimmer: replace the whole shimmerNetworkMini block -->
            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerNetworkMini"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="@id/gStart"
                app:layout_constraintEnd_toEndOf="@id/gEnd"
                app:layout_constraintTop_toBottomOf="@id/networkTitle"
                app:shimmer_auto_start="false"
                app:shimmer_base_alpha="0.9"
                app:shimmer_duration="1100"
                app:shimmer_highlight_alpha="0.6"
                app:shimmer_intensity="0.35">

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:paddingTop="8dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="6dp"
                        app:layout_columnWeight="1"
                        app:cardCornerRadius="20dp"
                        app:cardUseCompatPadding="true"
                        app:cardElevation="10dp">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="92dp"
                            android:background="@drawable/bg_card_matte" />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="6dp"
                        app:layout_columnWeight="1"
                        app:cardCornerRadius="20dp"
                        app:cardUseCompatPadding="true"
                        app:cardElevation="10dp">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="92dp"
                            android:background="@drawable/bg_card_matte" />
                    </com.google.android.material.card.MaterialCardView>
                </GridLayout>
            </com.facebook.shimmer.ShimmerFrameLayout>

            <!-- ANNOUNCEMENTS -->
            <TextView
                android:id="@+id/notificationTv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:paddingStart="8dp"
                android:paddingEnd="12dp"
                android:text="@string/fragment_home_announcements"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                app:layout_constraintEnd_toEndOf="@id/gEnd"
                app:layout_constraintStart_toStartOf="@id/gStart"
                app:layout_constraintTop_toBottomOf="@id/rvNetworkMini" />

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/announcementSlider"
                android:layout_width="0dp"
                android:layout_height="170dp"
                android:clipToPadding="false"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                app:layout_constraintEnd_toEndOf="@id/gEnd"
                app:layout_constraintStart_toStartOf="@id/gStart"
                app:layout_constraintTop_toBottomOf="@id/notificationTv" />

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerNotificationTitle"
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="@id/gEnd"
                app:layout_constraintStart_toStartOf="@id/gStart"
                app:layout_constraintTop_toBottomOf="@id/rvNetworkMini"
                app:shimmer_auto_start="false">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_card_matte" />
            </com.facebook.shimmer.ShimmerFrameLayout>

            <FrameLayout
                android:id="@+id/annShimmerWrap"
                android:layout_width="0dp"
                android:layout_height="170dp"
                app:layout_constraintEnd_toEndOf="@id/gEnd"
                app:layout_constraintStart_toStartOf="@id/gStart"
                app:layout_constraintTop_toBottomOf="@id/shimmerNotificationTitle">

                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmerAnnouncements"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"
                    app:shimmer_auto_start="false"
                    app:shimmer_base_alpha="0.9"
                    app:shimmer_duration="1100"
                    app:shimmer_highlight_alpha="0.6"
                    app:shimmer_intensity="0.35">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:outlineAmbientShadowColor="#FF7B00"
                        android:outlineSpotShadowColor="#FF7B00"
                        app:cardBackgroundColor="@color/main_card_color"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="12dp"
                        app:cardUseCompatPadding="true">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_card_matte" />
                    </com.google.android.material.card.MaterialCardView>
                </com.facebook.shimmer.ShimmerFrameLayout>
            </FrameLayout>

            <!-- DOCUMENTS -->
            <TextView
                android:id="@+id/docsTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:paddingStart="8dp"
                android:paddingEnd="12dp"
                android:text="@string/fragment_home_documents"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                app:layout_constraintEnd_toEndOf="@id/gEnd"
                app:layout_constraintStart_toStartOf="@id/gStart"
                app:layout_constraintTop_toBottomOf="@id/announcementSlider" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvDocuments"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="24dp"
                app:layout_constraintEnd_toEndOf="@id/gEnd"
                app:layout_constraintStart_toStartOf="@id/gStart"
                app:layout_constraintTop_toBottomOf="@id/docsTitle"
                tools:itemCount="1"
                tools:listitem="@layout/item_document" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
