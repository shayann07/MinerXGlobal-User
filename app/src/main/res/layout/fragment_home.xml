<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mxg_black">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/gStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_begin="8dp" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/gEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_end="8dp" />

            <!-- TOPBAR (unchanged, just added contentDescriptions) -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/topbar"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:paddingStart="8dp"
                android:paddingEnd="12dp"
                app:layout_constraintEnd_toEndOf="@id/gEnd"
                app:layout_constraintStart_toStartOf="@id/gStart"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/avatar"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/ic_profile"
                    android:contentDescription="@string/cd_profile_avatar"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:id="@+id/titleWrap"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="@id/avatar"
                    app:layout_constraintEnd_toStartOf="@id/actionsRight"
                    app:layout_constraintStart_toEndOf="@id/avatar"
                    app:layout_constraintTop_toTopOf="@id/avatar">

                    <TextView
                        android:id="@+id/hiName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hi_name"
                        android:textColor="@color/orange"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/welcome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fragment_home_welcome_to_minor_x_globe"
                        android:textColor="@color/mxg_white_80"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/actionsRight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/menu"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/ic_window"
                        android:contentDescription="@string/open_menu"
                        android:padding="8dp" />

                    <ImageView
                        android:id="@+id/notification_ic"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/ic_bell"
                        android:contentDescription="@string/notifications"
                        android:padding="8dp" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- HERO WALLET include -->
            <include
                android:id="@+id/walletHero"
                layout="@layout/item_wallet_hero"
                app:layout_constraintEnd_toEndOf="@id/gEnd"
                app:layout_constraintStart_toStartOf="@id/gStart"
                app:layout_constraintTop_toBottomOf="@id/topbar" />

            <!-- QUICK ACTIONS -->
            <LinearLayout
                android:id="@+id/quickActions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="@id/gEnd"
                app:layout_constraintStart_toStartOf="@id/gStart"
                app:layout_constraintTop_toBottomOf="@id/walletHero">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeposit"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/dialog_deposit_input_deposit"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    app:backgroundTint="@color/button_color"
                    app:cornerRadius="16dp" />

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWithdraw"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/withdraw"
                    android:textAllCaps="false"
                    app:cornerRadius="16dp"
                    app:iconTint="@color/orange"
                    app:strokeColor="@color/orange"
                    app:strokeWidth="1dp" />

                <Space
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnInvite"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/invite"
                    android:textAllCaps="false"
                    app:cornerRadius="16dp"
                    app:iconTint="@color/orange"
                    app:strokeColor="@color/orange"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <!-- STATS GRID (2x2) -->
            <TextView
                android:id="@+id/statsTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:paddingStart="8dp"
                android:paddingEnd="12dp"
                android:text="@string/overview"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="@id/gEnd"
                app:layout_constraintStart_toStartOf="@id/gStart"
                app:layout_constraintTop_toBottomOf="@id/quickActions" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvStatsGrid"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingTop="8dp"
                app:layout_constraintEnd_toEndOf="@id/gEnd"
                app:layout_constraintStart_toStartOf="@id/gStart"
                app:layout_constraintTop_toBottomOf="@id/statsTitle"
                tools:itemCount="1"
                tools:listitem="@layout/item_stat_small" />

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerStatsGrid"
                android:layout_width="0dp"
                android:layout_height="172dp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="@id/gEnd"
                app:layout_constraintStart_toStartOf="@id/gStart"
                app:layout_constraintTop_toBottomOf="@id/statsTitle"
                app:shimmer_auto_start="false"
                app:shimmer_base_alpha="0.9"
                app:shimmer_duration="1100"
                app:shimmer_highlight_alpha="0.6"
                app:shimmer_intensity="0.35">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_card_matte" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_card_matte" />
                </LinearLayout>
            </com.facebook.shimmer.ShimmerFrameLayout>

            <!-- NETWORK MINI (3 across) -->
            <TextView
                android:id="@+id/networkTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:paddingStart="8dp"
                android:paddingEnd="12dp"
                android:text="@string/fragment_home_network_stats"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="@id/gEnd"
                app:layout_constraintStart_toStartOf="@id/gStart"
                app:layout_constraintTop_toBottomOf="@id/rvStatsGrid" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvNetworkMini"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingTop="8dp"
                app:layout_constraintEnd_toEndOf="@id/gEnd"
                app:layout_constraintStart_toStartOf="@id/gStart"
                app:layout_constraintTop_toBottomOf="@id/networkTitle"
                tools:itemCount="1"
                tools:listitem="@layout/item_network_small" />

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerNetworkMini"
                android:layout_width="0dp"
                android:layout_height="92dp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="@id/gEnd"
                app:layout_constraintStart_toStartOf="@id/gStart"
                app:layout_constraintTop_toBottomOf="@id/networkTitle"
                app:shimmer_auto_start="false"
                app:shimmer_base_alpha="0.9"
                app:shimmer_duration="1100"
                app:shimmer_highlight_alpha="0.6"
                app:shimmer_intensity="0.35">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:paddingHorizontal="6dp">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_matte" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_matte" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_margin="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_card_matte" />
                </LinearLayout>
            </com.facebook.shimmer.ShimmerFrameLayout>

            <!-- ANNOUNCEMENTS -->
            <TextView
                android:id="@+id/notificationTv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:paddingStart="8dp"
                android:paddingEnd="12dp"
                android:text="@string/fragment_home_announcements"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="@id/gEnd"
                app:layout_constraintStart_toStartOf="@id/gStart"
                app:layout_constraintTop_toBottomOf="@id/rvNetworkMini" />

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/announcementSlider"
                android:layout_width="0dp"
                android:layout_height="170dp"
                android:clipToPadding="false"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                app:layout_constraintEnd_toEndOf="@id/gEnd"
                app:layout_constraintStart_toStartOf="@id/gStart"
                app:layout_constraintTop_toBottomOf="@id/notificationTv" />

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/shimmerNotificationTitle"
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="@id/gEnd"
                app:layout_constraintStart_toStartOf="@id/gStart"
                app:layout_constraintTop_toBottomOf="@id/rvNetworkMini"
                app:shimmer_auto_start="false">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_card_matte" />
            </com.facebook.shimmer.ShimmerFrameLayout>

            <FrameLayout
                android:id="@+id/annShimmerWrap"
                android:layout_width="0dp"
                android:layout_height="170dp"
                app:layout_constraintEnd_toEndOf="@id/gEnd"
                app:layout_constraintStart_toStartOf="@id/gStart"
                app:layout_constraintTop_toBottomOf="@id/shimmerNotificationTitle">

                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmerAnnouncements"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"
                    app:shimmer_auto_start="false"
                    app:shimmer_base_alpha="0.9"
                    app:shimmer_duration="1100"
                    app:shimmer_highlight_alpha="0.6"
                    app:shimmer_intensity="0.35">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:outlineAmbientShadowColor="#FF7B00"
                        android:outlineSpotShadowColor="#FF7B00"
                        app:cardBackgroundColor="@color/main_card_color"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="12dp"
                        app:cardUseCompatPadding="true">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_card_matte" />
                    </com.google.android.material.card.MaterialCardView>
                </com.facebook.shimmer.ShimmerFrameLayout>
            </FrameLayout>

            <!-- DOCUMENTS -->
            <TextView
                android:id="@+id/docsTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:paddingStart="8dp"
                android:paddingEnd="12dp"
                android:text="@string/fragment_home_documents"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="@id/gEnd"
                app:layout_constraintStart_toStartOf="@id/gStart"
                app:layout_constraintTop_toBottomOf="@id/announcementSlider" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvDocuments"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                tools:itemCount="1"
                tools:listitem="@layout/item_document"
                android:paddingBottom="24dp"
                app:layout_constraintEnd_toEndOf="@id/gEnd"
                app:layout_constraintStart_toStartOf="@id/gStart"
                app:layout_constraintTop_toBottomOf="@id/docsTitle" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
