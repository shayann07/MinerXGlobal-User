<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="170dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/walletHeroCard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:foreground="@drawable/ripple_dark"
        android:outlineAmbientShadowColor="#FF7B00"
        android:outlineSpotShadowColor="#FF7B00"
        card_view:cardCornerRadius="24dp"
        card_view:cardElevation="12dp"
        card_view:cardUseCompatPadding="true"
        card_view:strokeColor="@android:color/transparent"
        card_view:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_wallet_shiny"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/tvWalletTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MinerX Deposit Wallet"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWalletTotalLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Total USD"
                android:textColor="#C8FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvWalletAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="—"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
