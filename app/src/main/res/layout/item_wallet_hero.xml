<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Animated liquid gold card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/walletHeroCard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:foreground="@drawable/ripple_dark"
        android:outlineAmbientShadowColor="#FF7B00"
        android:outlineSpotShadowColor="#FF7B00"
        app:cardCornerRadius="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="16dp"
        app:cardUseCompatPadding="true"
        app:cardBackgroundColor="@color/orange"
        app:strokeColor="@android:color/transparent"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/tvWalletTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MinerX Deposit Wallet"
                android:textColor="@color/white"
                android:layout_gravity="center"
                android:background="@drawable/bg_pill_black"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWalletTotalLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Total USD"
                android:layout_gravity="center"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvWalletAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="$0.0"
                android:layout_gravity="center"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold" />
            <!-- QUICK ACTIONS -->
            <LinearLayout
                android:id="@+id/quickActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"

                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="@id/gEnd"
                app:layout_constraintStart_toStartOf="@id/gStart"
                app:layout_constraintTop_toBottomOf="@id/walletHero">

                <!-- Row: Deposit / Withdraw -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDeposit"


                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/main_card_color"
                        android:text="@string/dialog_deposit_input_deposit"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:textColor="@color/white"
                        android:ellipsize="end"
                        app:strokeColor="@color/orange"
                        app:cornerRadius="16dp" />

                    <Space
                        android:layout_width="12dp"
                        android:layout_height="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnWithdraw"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:text="@string/withdraw"
                        android:textAllCaps="false"
                        android:maxLines="1"
                        android:textColor="@color/white"
                        android:ellipsize="end"
                        app:cornerRadius="16dp"

                        android:backgroundTint="@color/main_card_color"
                        app:iconTint="@color/orange"
                        app:strokeColor="@color/orange"
                        app:strokeWidth="0dp" />
                </LinearLayout>

                <!-- Spacing between rows -->
                <Space
                    android:layout_width="1dp"
                    android:layout_height="12dp" />

                <!-- Referral “input” (full width, same edges as buttons) -->
                <TextView
                    android:id="@+id/inputReferral"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_referral_home"
                    android:drawablePadding="8dp"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="10dp"
                    android:singleLine="true"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    app:drawableEndCompat="@drawable/ic_link"
                    app:drawableTint="@color/black" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
