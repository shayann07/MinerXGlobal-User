<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="600dp"
    android:background="@android:color/transparent"
    >

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="24dp"
        app:strokeColor="@android:color/transparent"
        app:strokeWidth="0dp"> <!-- Glass effect -->

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@drawable/bg_mxg_drawer_gradient"
            android:padding="16dp">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="8dp"
                android:text="@string/dialoge_notification_bottom_sheet_this_week"
                android:textColor="@color/orange"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dialoge_notification_bottom_sheet_clearnotifications"
                android:layout_alignParentEnd="true"
                android:textColor="@color/orange"
                android:textSize="13sp"
                android:layout_marginEnd="10dp"
                android:layout_marginVertical="8dp"
                android:textStyle="bold"
                android:id="@+id/clearNotificationView"
                />

            <TextView
                android:id="@+id/noTv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_notifications_to_show"
                android:layout_centerInParent="true"
                android:textColor="@color/gray"
                android:textSize="16sp"
                android:visibility="gone"
                android:layout_marginTop="8dp"
                />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/notificationRv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@id/clearNotificationView"
                android:layout_marginTop="10dp"
                tools:listitem="@layout/item_notifications" />
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
