<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="20dp"
    android:maxWidth="380dp"
    android:outlineAmbientShadowColor="#FF7B00"
    android:outlineSpotShadowColor="#FF7B00"
    android:elevation="6dp"
    app:cardCornerRadius="22dp"
    app:cardUseCompatPadding="false"
    app:strokeWidth="0dp"

    app:cardBackgroundColor="@android:color/transparent">

    <!-- Stacked: header chips + amount | centered QR | instruction | full-width address -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_mxg_drawer_gradient"
        android:padding="16dp">

        <!-- Chips row: Network + Timer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            >


            <TextView
                android:id="@+id/chipNetwork"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="@string/dialog_qr_scan_bep20"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/bg_chip_soft" />

            <!-- Timer chip (ID preserved) -->
            <TextView
                android:id="@+id/tvTimerDialog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:layout_marginStart="@dimen/dp_10"
                android:paddingBottom="6dp"
                android:text="@string/dialog_qr_scan_time_left_00_00_00"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/bg_chip_soft" />
        </LinearLayout>

        <!-- Amount (centered, bold) -->
        <TextView
            android:id="@+id/amountVal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/dialog_qr_scan_amount_200"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center" />

        <!-- Centered QR panel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_margin="20dp"
            android:background="@drawable/bg_qr_panel"
            android:padding="10dp">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:foregroundGravity="center"
                android:background="@drawable/bg_qr_border"
                android:padding="10dp">

                <!-- QR image (ID preserved) -->
                <ImageView
                    android:id="@+id/ivQRCode"
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_gravity="center"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/app_name"
                    android:scaleType="centerInside" />
            </FrameLayout>

            <!-- Tiny tip below QR -->
            <TextView
                android:id="@+id/tvQrTip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Scan in your wallet app"
                android:textSize="11sp"
                android:textColor="@color/white"
                android:alpha="0.7"
                android:gravity="center" />
        </LinearLayout>

        <!-- Instruction -->
        <TextView
            android:id="@+id/tvInstruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/dialog_qr_scan_deposit_amount_on_this_address"
            android:textSize="12sp"
            android:textColor="@color/white"
            android:alpha="0.8"
            android:gravity="center" />

        <!-- Full-width address bar at bottom (IDs preserved) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_address_glass"
            android:padding="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/sendingAddress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:singleLine="true"
                android:text="0x0000...0000"
                android:textSize="13sp"
                android:textColor="@color/white"
                android:alpha="0.92"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textIsSelectable="true" />

            <ImageView
                android:id="@+id/copyButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@null"
                android:padding="10dp"
                android:src="@drawable/ic_link"
                android:background="@drawable/bg_icon_button"
                app:tint="@color/black" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
