<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    android:outlineAmbientShadowColor="#FF7B00"
    android:outlineSpotShadowColor="#FF7B00"
    app:cardBackgroundColor="@color/main_card_color"
    app:cardCornerRadius="20dp"
    app:cardElevation="6dp"
    app:cardMaxElevation="6dp"
    app:cardUseCompatPadding="true"
    app:strokeColor="@android:color/transparent"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="72dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <!-- Image smaller (64dp) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/planImageCard"
            android:layout_width="64dp"
            android:layout_height="64dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="#33FF7B00"
            app:strokeWidth="1dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/ivPlan"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/app_name"
                android:scaleType="centerInside"
                android:src="@drawable/mining_1" />
        </com.google.android.material.card.MaterialCardView>

        <!-- EXPIRED chip (compact) -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chipExpired"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:visibility="gone"
            android:text="@string/expired"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:paddingHorizontal="8dp"
            android:textColor="@android:color/white"
            app:chipIconVisible="false"
            app:chipBackgroundColor="@color/design_default_color_error"
            app:chipStrokeWidth="0dp"
            app:rippleColor="@android:color/transparent"
            app:layout_constraintTop_toTopOf="@id/planImageCard"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Title & range (smaller text, tighter margins) -->
        <TextView
            android:id="@+id/tvName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/item_plan_starter_plan"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintStart_toEndOf="@id/planImageCard"
            app:layout_constraintTop_toTopOf="@id/planImageCard"
            app:layout_constraintEnd_toStartOf="@id/chipExpired"
            app:layout_goneMarginEnd="0dp" />

        <TextView
            android:id="@+id/tvRange"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/item_plan_n_100_1000"
            android:textColor="@color/grey"
            android:textSize="11sp"
            app:layout_constraintStart_toStartOf="@id/tvName"
            app:layout_constraintTop_toBottomOf="@id/tvName"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Stats row (reduced spacing & font sizes) -->
        <LinearLayout
            android:id="@+id/statsRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="@id/tvName"
            app:layout_constraintTop_toBottomOf="@id/tvRange"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/item_plan_daily"
                    android:textColor="@color/grey"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvDaily"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/item_plan_n_1_5"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="8dp"
                android:background="#22FFFFFF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/item_plan_direct"
                    android:textColor="@color/grey"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvDirect"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/item_available_plans_1_n_5"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="8dp"
                android:background="#22FFFFFF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/item_plan_payout"
                    android:textColor="@color/grey"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvPayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/item_plan_n_200"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom spacing trimmed -->
        <Space
            android:layout_width="0dp"
            android:layout_height="4dp"
            app:layout_constraintTop_toBottomOf="@id/statsRow"
            app:layout_constraintStart_toStartOf="@id/statsRow"
            app:layout_constraintEnd_toEndOf="@id/statsRow" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
