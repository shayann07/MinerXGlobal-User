<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginTop="16dp"
    android:backgroundTint="@color/main_card_color"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="16dp"
    android:layout_margin="20dp"
    android:background="@drawable/transparent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"

       >
        <!-- Profile Image -->
        <ImageView
            android:id="@+id/profile_image"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="5dp"
            android:clipToOutline="true"
            android:contentDescription="@string/item_user_chat_preview_profile_image"
            android:scaleType="centerCrop"
            android:shape="oval"
            android:src="@drawable/ic_profile_drawer"
            app:tint="@color/orange"/>

        <!-- User Name and Last Message -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/dp_10"
            >

            <TextView
                android:id="@+id/user_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/item_user_chat_preview_user_name"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/last_message"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/item_user_chat_preview_last_message_preview"
                android:textColor="#888888"
                android:padding="4dp"
                android:layout_marginBottom="@dimen/dp_10"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Timestamp -->
        <TextView
            android:id="@+id/timestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="@string/item_user_chat_preview_n_10_30_am"
            android:textColor="@color/white"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="8dp"
        android:background="@color/black" />
</com.google.android.material.card.MaterialCardView>
